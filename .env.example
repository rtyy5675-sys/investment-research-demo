PORT=8791
# 云端临时实例设置 ephemeral，前端会说明重启后本地记录不保留。
# 普通生产服务可设置 server，保存期限由实际部署存储决定。
# RESEARCH_STORAGE_MODE=ephemeral
MODEL_PROVIDER=codex
# 可选：使用OpenAI兼容API时设置，密钥只存在服务端环境。
# MODEL_PROVIDER=openai-compatible
# MODEL_BASE_URL=https://api.openai.com/v1
# MODEL_API_KEY=
# MODEL_NAME=
# CLI模式默认沿用CLI服务端默认模型，不强制指定。
# CODEX_MODEL=

# 扶摇MCP：密钥仅填在本机.env.local，不进入前端或Git。保存后无需重启。
FUYAO_API_KEY=

# 研究运行预算：在启动进程的环境中设置，修改后重启；不是写入本机Key配置。
# RESEARCH_MAX_DURATION_MS=240000
# RESEARCH_MAX_MODEL_CALLS=4
# RESEARCH_MAX_TOOL_CALLS=8
# RESEARCH_MAX_KNOWN_TOKENS=120000
# RESEARCH_MAX_INPUT_CHARS=48000
# CODEX_REASONING_EFFORT=low
# 模型传输与正文上限；超限报错，不发布半份JSON。不是供应商费用上限。
# MODEL_MAX_RESPONSE_BYTES=1048576
# MODEL_MAX_OUTPUT_CHARS=24000
